          "queryType": "table",
          "timeColumns": [
            "time"
          ],
          "queryText": "SELECT $__unixEpochGroupSeconds(ts, 3600) AS time, AVG(success) AS success_rate FROM poll_attempts WHERE ts BETWEEN ${__from:date:seconds} AND ${__to:date:seconds} AND name IN (${repeater:singlequote}) GROUP BY 1 ORDER BY 1 ASC",
          "rawQueryText": "SELECT $__unixEpochGroupSeconds(ts, 3600) AS time, AVG(success) AS success_rate FROM poll_attempts WHERE ts BETWEEN ${__from:date:seconds} AND ${__to:date:seconds} AND name IN (${repeater:singlequote}) GROUP BY 1 ORDER BY 1 ASC"
