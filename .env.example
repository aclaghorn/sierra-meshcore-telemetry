# Copy to .env and adjust. Used by docker-compose.yml.

# Host serial device for the MeshCore companion radio.
SERIAL_PORT=/dev/ttyACM0

# Group id that owns the serial device: `stat -c '%G %g' /dev/ttyACM0`
SERIAL_GID=46

# Collector log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

TZ=America/Los_Angeles

# Profile loaded from the host's read-only ~/.aws mount.
AWS_PROFILE=default
# Group that owns ~/.aws: `stat -c '%g' ~/.aws`
AWS_CONFIG_GID=1000

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
